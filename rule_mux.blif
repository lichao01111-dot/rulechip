# RuleChip RuleMux - selects between two WallRule outputs, flat NAND, 22 gates
# out = h ? a : b   (h = d0 = 1 when moving LEFT/RIGHT)
# inputs little-endian: a_nx2..a_dead (bits0-6) b_nx2..b_dead (bits7-13) h (bit14)
.model rule_mux
.inputs a_nx2 a_nx1 a_nx0 a_ny2 a_ny1 a_ny0 a_dead b_nx2 b_nx1 b_nx0 b_ny2 b_ny1 b_ny0 b_dead h
.outputs nx2 nx1 nx0 ny2 ny1 ny0 dead
.names h h g1
0- 1
-0 1
.names b_nx2 g1 g2
0- 1
-0 1
.names a_nx2 h g3
0- 1
-0 1
.names g2 g3 nx2
0- 1
-0 1
.names b_nx1 g1 g5
0- 1
-0 1
.names a_nx1 h g6
0- 1
-0 1
.names g5 g6 nx1
0- 1
-0 1
.names b_nx0 g1 g8
0- 1
-0 1
.names a_nx0 h g9
0- 1
-0 1
.names g8 g9 nx0
0- 1
-0 1
.names b_ny2 g1 g11
0- 1
-0 1
.names a_ny2 h g12
0- 1
-0 1
.names g11 g12 ny2
0- 1
-0 1
.names b_ny1 g1 g14
0- 1
-0 1
.names a_ny1 h g15
0- 1
-0 1
.names g14 g15 ny1
0- 1
-0 1
.names b_ny0 g1 g17
0- 1
-0 1
.names a_ny0 h g18
0- 1
-0 1
.names g17 g18 ny0
0- 1
-0 1
.names b_dead g1 g20
0- 1
-0 1
.names a_dead h g21
0- 1
-0 1
.names g20 g21 dead
0- 1
-0 1
.end
